# ERPGuard v0.12.0-rc1 VPS environment.
# Copy to /etc/erpguard/erpguard.env and keep ownership readable by the erpguard service user.

ERPGUARD_ENV=release_candidate
ERPGUARD_ENVIRONMENT=release-candidate
ERPGUARD_DATA_DIR=/var/lib/erpguard
ERPGUARD_DB_URL=sqlite:////var/lib/erpguard/erpguard.db
ERPGUARD_DATABASE_URL=sqlite:////var/lib/erpguard/erpguard.db
ERPGUARD_HOST=0.0.0.0
ERPGUARD_PORT=8000

# Release safety boundaries. Do not enable these by default.
ALLOW_REAL_ODOO_WRITES=false
ALLOW_R1_REAL_WRITE_PILOT=false
ALLOW_R2_REAL_WRITE_PILOT=false
ALLOW_GENERIC_REAL_ODOO_WRITES=false
ALLOW_R3_R4_REAL_WRITES=false
